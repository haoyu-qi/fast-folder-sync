{
  "name": "fast-folder-sync",
  "productName": "Fast Folder Sync",
  "version": "0.2.2",
  "description": "Standalone folder backup and synchronization client",
  "author": "Fast Folder Sync contributors",
  "license": "Apache-2.0",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "check": "node --check main.cjs && node --check preload.cjs && node --check renderer.js && node --check lib/files.cjs && node --check lib/local-sync.cjs && node --check lib/fns-sync.cjs",
    "pack": "electron-builder --dir",
    "dist:win": "electron-builder --win portable",
    "dist:mac": "electron-builder --config electron-builder.mac.cjs --mac dmg zip --arm64 --x64",
    "dist:mac:zip": "electron-builder --config electron-builder.mac.cjs --mac zip --arm64 --x64",
    "start:mac-preview": "electron . --mac-preview",
    "check:mac": "node --check mac/platform.cjs && node --check mac/preload.cjs && node --check mac/renderer.js && node --check mac/icons.js && node --check mac/verify.cjs && node --check electron-builder.mac.cjs",
    "dist:linux": "electron-builder --linux AppImage"
  },
  "dependencies": {
    "ws": "8.18.3"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "org.fastfoldersync.desktop",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "renderer.js",
      "index.html",
      "style.css",
      "icon.png",
      "icon.ico",
      "lib/**",
      "package.json",
      "LICENSE"
    ],
    "icon": "icon.png",
    "win": {
      "artifactName": "Fast-Folder-Sync-${version}-Windows-${arch}.${ext}",
      "target": "portable",
      "icon": "icon.ico",
      "signAndEditExecutable": false
    },
    "mac": {
      "category": "public.app-category.utilities"
    },
    "linux": {
      "category": "Utility"
    }
  }
}
